# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build.log

# local env files
#
# Deny everything starting with .env, then allow back the one file that is
# meant to be committed. Enumerating patterns instead (.env, .env*.local, …)
# left real holes: a `.env.local.bak` taken before an edit, or a
# `.env.vercel` from `vercel env pull`, matched none of them and git would
# have tracked a file full of live keys. Both of those happened here.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase
.branches
.temp

# claude code (keep launch.json shared; ignore machine-local settings)
.claude/settings.local.json

# tutor grounding eval reports (scripts/tutor-eval.mjs) — run output, not source
.tutor-eval/
