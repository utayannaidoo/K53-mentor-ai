/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build.log

# local env files
.env
.env*.local
.env.local
# Backups and editor scratch copies of the above. Without this, a
# `.env.local.bak` sits outside every pattern here and git will happily track a
# file full of live keys.
.env.local.*
.env.*.bak*

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase
.branches
.temp

# claude code (keep launch.json shared; ignore machine-local settings)
.claude/settings.local.json

# tutor grounding eval reports (scripts/tutor-eval.mjs) — run output, not source
.tutor-eval/
