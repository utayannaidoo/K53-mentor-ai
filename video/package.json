{
  "name": "k53-launch-film",
  "version": "1.0.0",
  "description": "K53 Mentor AI — cinematic launch film (Remotion).",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.505",
    "@remotion/google-fonts": "4.0.505",
    "@remotion/media": "4.0.505",
    "@remotion/motion-blur": "4.0.505",
    "@remotion/noise": "4.0.505",
    "@remotion/paths": "4.0.505",
    "@remotion/shapes": "4.0.505",
    "@remotion/tailwind-v4": "4.0.505",
    "@remotion/transitions": "4.0.505",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.505",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.505",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "assets": "npm run audio && npm run noise",
    "audio": "node scripts/synth-audio.mjs",
    "noise": "node scripts/gen-noise.mjs",
    "vo": "node scripts/generate-vo.mjs",
    "vo:dry": "node scripts/generate-vo.mjs --dry",
    "vo:sfx": "node scripts/generate-vo.mjs --sfx",
    "vo:compare": "node scripts/generate-vo.mjs --compare",
    "dev": "remotion studio",
    "stills": "node scripts/stills.mjs",
    "render:preview": "remotion render LaunchFilm out/k53-launch-preview.mp4 --scale=0.5",
    "render:1440": "remotion render LaunchFilm out/k53-launch-1440p.mp4",
    "render:4k": "remotion render LaunchFilm out/k53-launch-4k.mp4 --scale=1.5",
    "render:9x16": "remotion render LaunchFilm-9x16 out/k53-launch-9x16.mp4 --scale=2",
    "render:1x1": "remotion render LaunchFilm-1x1 out/k53-launch-1x1.mp4 --scale=1.8",
    "render:all": "npm run render:4k && npm run render:9x16 && npm run render:1x1",
    "render:master": "remotion render LaunchFilm out/k53-launch-master.mov --codec=prores --prores-profile=hq --scale=1.5",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc --noEmit"
  },
  "sideEffects": [
    "*.css"
  ]
}
